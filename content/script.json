  "lines": [
    {
      "actor": "B",
      "text": "お母さん！荷造り、終わった！明日、東京に行きます！",
      "style": "high",
      "level": "normal",
      "gapAfter": 0.6
    },
    {
      "actor": "A",
      "text": "はいはい。東京に行って、何になるんだっけ。",
      "style": "calm",
      "level": "normal",
      "gapAfter": 0.9
    },
    {
      "actor": "B",
      "text": "……何回も言ったでしょ。日本最強の、録音部。",
      "style": "sad",
      "level": "whisper",
      "gapAfter": 0.8
    },
    {
      "actor": "A",
      "text": "ろくおんぶ。……部活？",
      "style": "normal",
      "level": "normal",
      "gapAfter": 0.5
    },
    {
      "actor": "B",
      "text": "部活じゃない！映画の現場で、棒の先のマイクで、役者の声を録る人！",
      "style": "angry",
      "level": "loud",
      "gapAfter": 1
    },
    {
      "actor": "A",
      "text": "……声が大きい。お隣に聞こえる。",
      "style": "calm",
      "level": "whisper",
      "gapAfter": 0.9
    },
    {
      "actor": "B",
      "text": "……小声でも録れる人になるの。だから、東京に行くの。",
      "style": "sad",
      "level": "whisper",
      "gapAfter": 1.1
    },
    {
      "actor": "A",
      "text": "棒なら、駅前のホームセンターにもあるけど。",
      "style": "high",
      "level": "normal",
      "gapAfter": 0.5
    },
    {
      "actor": "B",
      "text": "棒じゃなくて、ブームポール！",
      "style": "angry",
      "level": "normal",
      "gapAfter": 0.8
    },
    {
      "actor": "A",
      "text": "とにかく、反対。お父さんも反対って言ってた。",
      "style": "calm",
      "level": "normal",
      "gapAfter": 0.5
    },
    {
      "actor": "B",
      "text": "お父さん、ずっと寝てたじゃん！",
      "style": "normal",
      "level": "normal",
      "gapAfter": 0.5
    },
    {
      "actor": "A",
      "text": "寝言で言ってた。",
      "style": "high",
      "level": "normal",
      "gapAfter": 2.2
    },
    {
      "actor": "B",
      "text": "もう。じゃあ、お母さんの「行ってきなさい」を録音して、お守りにする。はい、どうぞ。",
      "style": "happy",
      "level": "normal",
      "gapAfter": 2.4
    },
    {
      "actor": "A",
      "text": "……録るなら、口元をちゃんと狙いなさい。",
      "style": "calm",
      "level": "normal",
      "gapAfter": 1
    },
    {
      "actor": "B",
      "text": "え。なんで知ってるの。",
      "style": "normal",
      "level": "normal",
      "gapAfter": 0.6
    },
    {
      "actor": "A",
      "text": "早く寝なさい。",
      "style": "calm",
      "level": "normal",
      "gapAfter": 1.5
    }
  ],
