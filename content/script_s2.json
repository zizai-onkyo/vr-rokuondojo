  "lines": [
    { "actor": "C", "text": "おはよー！ハル！見送りに来たぞー！", "style": "normal", "level": "loud", "gapAfter": 0.5 },
    { "actor": "B", "text": "ソウタ！……え、何それ。長いの。", "style": "normal", "level": "normal", "gapAfter": 0.7 },
    { "actor": "B", "text": "お母さーん！ソウタが、変なの持ってきたー！", "style": "high", "level": "loud", "gapAfter": 0.9 },
    { "actor": "A", "text": "朝から大きい声。……あら、ソウタくん。それ、物干し竿？", "style": "calm", "level": "normal", "gapAfter": 0.5 },
    { "actor": "C", "text": "ブームポールです！ハルが東京で使うって聞いて。ホームセンターで、一番長いの買ってきました！", "style": "normal", "level": "normal", "gapAfter": 0.6 },
    { "actor": "A", "text": "ホームセンター。ほら、言ったでしょ。", "style": "high", "level": "normal", "gapAfter": 0.8 },
    { "actor": "B", "text": "……ソウタ。これ、洗濯物を干す棒。", "style": "sad", "level": "whisper", "gapAfter": 0.9 },
    { "actor": "A", "text": "ハル。電車の時間。", "style": "normal", "level": "normal", "gapAfter": 0.6 },
    { "actor": "B", "text": "……お母さん。昨日の、まだ言ってくれてないんだけど。", "style": "sad", "level": "normal", "gapAfter": 1.1 },
    { "actor": "C", "text": "あ、おれ、荷物持つよ。棒も持つ。", "style": "normal", "level": "normal", "gapAfter": 0.6 },
    { "actor": "A", "text": "ハル。玄関の黒いケース、持っていきなさい。昔、私が使ってたの。", "style": "calm", "level": "normal", "gapAfter": 0.9 },
    { "actor": "B", "text": "……え。お母さん、録音部だったの？", "style": "sad", "level": "whisper", "gapAfter": 0.8 },
    { "actor": "A", "text": "行ってきなさい！……録らなくていいから！", "style": "happy", "level": "loud", "gapAfter": 1.5 }
  ],
